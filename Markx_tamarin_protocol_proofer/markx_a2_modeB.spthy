/*
 * MARK-X: Migration-Aware Authenticated Re-Key Exchange
 * Tamarin model for symbolic protocol verification
 *
 * Scope:
 *   - Variant A2 (explicit ECDH).
 *   - Mode B (chain bootstrap): epoch e0+1 is bootstrapped with a MAC
 *     under K_chain established at epoch e0.
 *   - The Mode A epoch (e0) that established K_chain is *abstracted*
 *     by a single setup rule SetupChainState. This is the standard
 *     Tamarin idiom for chained / ratcheted protocols (e.g. the
 *     Signal X3DH model) and matches KDF's input assumption that
 *     the prior epoch was already established under Theorem 1.
 *     Composing the full Mode A unrolling with Mode B causes the
 *     autoprover to fail to terminate on basic lemmas because the
 *     source-saturation procedure cannot bound the chain depth even
 *     with -c=30; see the README for a discussion of this limitation
 *     and how interactive composition would be done.
 *
 * Difference from markx_a2_modeA.spthy:
 *   - The prior-epoch state is created by a single SetupChainState
 *     rule that produces !ChainKey($S, $C, ~kchain) facts.
 *   - Server_Phase1_ChainBoot consumes !ChainKey and uses
 *     mac(kchain, <'MARK-X-v2-ChainBoot', ctx_1>) for authentication.
 *   - Client_Phase1_ChainBoot verifies with the same kchain.
 *   - Phases 2, 3, 3' are identical to markx_a2_modeA.spthy.
 *   - A new Reveal_Kchain oracle.
 *
 * Property catalogue (STABLE by default):
 *
 *   sanity_executable        -- a chained-epoch transition completes
 *                               (exists-trace).
 *   policy_compliance        -- client only accepts policy-compliant ctx_1.
 *   chain_auth               -- client acceptance of a chained
 *                               m_1 implies a matching server chain step or
 *                               a prior K_chain reveal.
 *   secrecy_ktrans           -- K_trans secret under chain-fresh A2 conditions.
 *   secrecy_ktrans_one_leak  -- A2 leakage-resilient secrecy in chained epoch.
 *
 * Usage:
 *   tamarin-prover --derivcheck-timeout=0 --prove markx_a2_modeB.spthy
 */

theory MARK_X_A2_ModeB
begin

builtins: hashing, signing, diffie-hellman

functions: pk_kem/1
functions: kemEnc/3, kemDec/2
functions: mac/2

equations: kemDec(kemEnc(K, pk_kem(s), r), s) = K

/* ------------------------------------------------------------------ *
 * Setup
 *
 * SetupChainState abstracts the Mode A epoch e0: it generates a fresh
 * ~kchain that both the server and client have stored. The persistent
 * fact !ChainKey($S, $C, ~kchain) binds it to the (server, client)
 * pair so that Server_Phase1_ChainBoot and Client_Phase1_ChainBoot
 * agree on the same key.
 *
 * In a real deployment ~kchain would be the output of the Mode A
 * epoch's K_chain derivation (markx_a2_modeA.spthy proves this is
 * secret under A2-fresh conditions); we abstract that composition
 * here for autoproof tractability.
 * ------------------------------------------------------------------ */

rule SetupPolicy:
    [ Fr(~policy) ]
  --[ PolicyInstalled($S, $C, ~policy) ]->
    [ !ServerPolicy($S, ~policy)
    , !ClientLocalPolicy($C, ~policy) ]

rule SetupChainState:
    [ Fr(~kchain), Fr(~sid_prev_s), Fr(~sid_prev_c) ]
  --[ ChainStateInstalled($S, $C, ~kchain) ]->
    [ !ChainKeyServer($S, ~sid_prev_s, ~kchain)
    , !ChainKeyClient($C, $S, ~sid_prev_c, ~kchain) ]

/* ------------------------------------------------------------------ *
 * Corruption oracles
 * ------------------------------------------------------------------ */

rule Corrupt_KEM:
    [ !KemSk(sid, $S, kemSk) ]
  --[ CorruptKEM(sid, $S) ]->
    [ Out(kemSk) ]

rule Corrupt_ServerEph:
    [ !ServerEph(sid, $S, skeph) ]
  --[ CorruptServerEph(sid, $S) ]->
    [ Out(skeph) ]

rule Corrupt_ClientEph:
    [ !ClientEph(sid, $C, x) ]
  --[ CorruptClientEph(sid, $C) ]->
    [ Out(x) ]

// Client enrolment (Assumption: Client Enrolment). See markx_a2_modeA.spthy
// for the rationale: pk_C is served from the registry, never from the wire.

/* ------------------------------------------------------------------ *
 * Client local allow-list (policy acceptance)
 * ------------------------------------------------------------------ */
// The client's local allow-list, carried explicitly rather than collapsed
// into "policies match by hash".
//
// The earlier modelling checked Eq(policyHash, h(~policy)), i.e. that the
// server's announced policy was byte-identical to the client's.  That is a
// STRONGER acceptance rule than the protocol imposes, so a lemma closing
// under it did not establish the corresponding property of the protocol.
// It is also incompatible with broadcasting one signed m_1 to a fleet and
// with staged sunset rollout, where clients legitimately differ.
//
// Instead each allowed value is a persistent fact.  A rule that takes such a
// fact as a premise can only fire when the fact exists, which is exactly
// membership in the allow-list.  The announced policy hash is left
// unconstrained, matching the protocol.
rule SetupClientAllowsAlg:
    [ ] --[ AlgAllowed($C, $algId, $paramId) ]->
    [ !ClientAllowsAlg($C, $algId, $paramId) ]

rule SetupClientAllowsVariant:
    [ ] --[ VariantAllowed($C, $variantTag) ]->
    [ !ClientAllowsVariant($C, $variantTag) ]

// Bootstrap anchors.  A client is CLASSICALLY SUNSET exactly when this rule
// is never instantiated with 'modeA_c' for it -- no fact, so no acceptance
// path through a classically-anchored bootstrap, irrespective of whether
// sigma_1 verifies.  That is the symbolic content of the claim that
// retirement must be enforced by the receiver.
rule SetupClientAllowsAnchor:
    [ ] --[ AnchorAllowed($C, $modeTag) ]->
    [ !ClientAllowsAnchor($C, $modeTag) ]

rule SetupClientStatic:
    [ Fr(~skC) ]
  --[ ClientEnrolled($S, $C, ~skC) ]->
    [ !ClientStatic($C, ~skC)
    , !ClientRegistry($S, $C, 'g'^~skC)
    , Out('g'^~skC) ]

// CorruptStatic: leak the client's long-term static ECDH secret.
rule Corrupt_ClientStatic:
    [ !ClientStatic($C, skC) ]
  --[ CorruptClientStatic($C) ]->
    [ Out(skC) ]

rule Reveal_Ktrans:
    [ !KtransOf(sid, ktrans) ]
  --[ RevealKtrans(sid) ]->
    [ Out(ktrans) ]

// Mode-B specific: leak the chain key used to authenticate the chained
// epoch's bootstrap.
rule Reveal_Kchain_Server:
    [ !ChainKeyServer($S, sid_prev, kchain) ]
  --[ RevealKchain(sid_prev) ]->
    [ Out(kchain) ]

/* ------------------------------------------------------------------ *
 * Chained epoch e0+1: Mode-B bootstrap (MAC under K_chain)
 * ------------------------------------------------------------------ */

rule Server_Phase1_ChainBoot:
    let pkpq    = pk_kem(~skpq)
        ctx1    = <pkpq, $algId, $paramId, $e, $ctr, h(~policy), 'A2', 'modeB', 'g'^~skeph>
        mac1    = mac(kchain, <'MARK-X-v2-ChainBoot', ctx1>)
        m1      = <ctx1, mac1>
    in
    [ Fr(~sid), Fr(~skpq), Fr(~skeph)
    , !ChainKeyServer($S, sid_prev, kchain)
    , !ServerPolicy($S, ~policy) ]
  --[ ServerSentM1Chain(~sid, $S, sid_prev, $algId, $paramId, $e, $ctr, h(~policy), pkpq, 'g'^~skeph)
    , ServerChainStep(~sid, $S, sid_prev) ]->
    [ Out(m1)
    , !KemSk(~sid, $S, ~skpq)
    , !ServerEph(~sid, $S, ~skeph)
    , St_Server_1(~sid, $S, sid_prev, ~skpq, ~skeph, ~policy, $algId, $paramId, $e, $ctr, kchain)
    ]

rule Client_Phase1_ChainBoot:
    let ctx1 = <pkpq, algId, paramId, e, ctr, policyHash, variantTag, modeTag, pkeph>
        m1   = <ctx1, mac1>
    in
    [ In(m1)
    , !ClientLocalPolicy($C, ~policy)
    // Allow-list membership, as premises.  The announced policyHash is NOT
    // required to equal h(~policy): see SetupClientAllowsAlg above.
    , !ClientAllowsAlg($C, algId, paramId)
    , !ClientAllowsVariant($C, variantTag)
    , !ClientAllowsAnchor($C, modeTag)
    , !ChainKeyClient($C, $S, sid_prev_c, kchain)
    , Fr(~sid_c), Fr(~x) ]
  --[ Eq(mac1, mac(kchain, <'MARK-X-ChainBoot', ctx1>))
    , Eq(variantTag, 'A2')
    , ClientReceivedM1Chain(~sid_c, $C, $S, sid_prev_c, algId, paramId, e, ctr, policyHash, pkpq, pkeph)
    , ClientChecksPolicy($C, policyHash)
    , ClientAcceptedAnchor(~sid_c, $C, modeTag)
    , ClientChainStep(~sid_c, $C, sid_prev_c) ]->
    [ St_Client_1(~sid_c, $C, $S, sid_prev_c, ~x, policyHash, algId, paramId, e, ctr, pkpq, pkeph, m1, kchain)
    , !ClientEph(~sid_c, $C, ~x) ]

/* ------------------------------------------------------------------ *
 * Phases 2 and 3 (chained epoch)
 * ------------------------------------------------------------------ */

rule Client_Phase2:
    let
        ctpq     = kemEnc(~Kpq, pkpq, ~r)
        gx       = 'g'^x
        Kclass   = h(<pkeph^x, pkeph^skC>)
        tr       = h(<m1, $C, ctpq, gx>)
        k1       = h(<~Kpq, Kclass, 'MARK-X-Phase2', tr>)
        tag1     = mac(k1, <'client-confirm', tr>)
    in
    [ St_Client_1(sid_c, $C, $S, sid_prev_c, x, policyHash, algId, paramId, e, ctr, pkpq, pkeph, m1, kchain)
    , !ClientStatic($C, skC)
    , Fr(~r), Fr(~Kpq) ]
  --[ ClientSentM2(sid_c, $C, $S, ctpq, gx, tag1)
    , ClientHasKpq(sid_c, $C, ~Kpq) ]->
    [ Out(<$C, ctpq, gx, tag1>)
    , St_Client_2(sid_c, $C, $S, sid_prev_c, x, policyHash, algId, paramId, e, ctr, pkpq, pkeph, m1,
                  ctpq, gx, ~Kpq, Kclass, tr) ]

rule Server_Phase2:
    let
        ctx1   = <pk_kem(skpq), algId, paramId, e, ctr, h(policy), 'A2', 'modeB', 'g'^skeph>
        mac1   = mac(kchain, <'MARK-X-ChainBoot', ctx1>)
        m1     = <ctx1, mac1>
        Kpq    = kemDec(ctpq, skpq)
        Kclass = h(<gx^skeph, pkC^skeph>)
        tr     = h(<m1, $C, ctpq, gx>)
        k1     = h(<Kpq, Kclass, 'MARK-X-Phase2', tr>)
    in
    [ In(<$C, ctpq, gx, tag1>)
    , St_Server_1(sid, $S, sid_prev, skpq, skeph, policy, algId, paramId, e, ctr, kchain)
    , !ClientRegistry($S, $C, pkC)      // enrolment lookup, not from the wire
    ]
  --[ Eq(tag1, mac(k1, <'client-confirm', tr>))
    , ServerVerifiedM2(sid, $S, ctpq, gx, tag1)
    , ServerAcceptedClient(sid, $S, $C, tr)
    , ServerHasKpq(sid, $S, Kpq)
    ]->
    [ St_Server_2(sid, $S, sid_prev, skpq, skeph, policy, algId, paramId, e, ctr,
                  ctpq, gx, Kpq, Kclass, tr) ]

rule Server_Phase3:
    let
        Ktrans = h(<Kpq, Kclass, e, ctr, h(policy), 'MARK-X-Trans', tr>)
        Kchain_new = h(<Kpq, Kclass, e, ctr, 'MARK-X-Chain', tr>)
        // Phase-3 confirmation key.  Deliberately NOT Ktrans: MACing under
        // the tested key puts a public deterministic function of it on the
        // wire, which breaks real-or-random transition secrecy outright.
        // The symbolic model cannot see that break (mac/2 is one-way here),
        // which is why the separation is enforced in the model as well.
        k2     = h(<Kpq, Kclass, e, ctr, h(policy), 'MARK-X-Phase3', tr>)
        tag2   = mac(k2, <'promote-to-PQ', e, ctr, algId, h(policy)>)
        m3     = <'promote-to-PQ', e, ctr, tag2>
    in
    [ St_Server_2(sid, $S, sid_prev, skpq, skeph, policy, algId, paramId, e, ctr,
                  ctpq, gx, Kpq, Kclass, tr) ]
  --[ ServerCommits(sid, $S, e, ctr, algId, paramId, h(policy), pk_kem(skpq))
    , ServerKtrans(sid, $S, Ktrans)
    , ServerKchain(sid, $S, Kchain_new)
    ]->
    [ Out(m3)
    , !KtransOf(sid, Ktrans) ]

rule Client_Phase3:
    let
        Ktrans = h(<Kpq, Kclass, e, ctr, h(policy), 'MARK-X-v2-Trans', tr>)
        Kchain_new = h(<Kpq, Kclass, e, ctr, 'MARK-X-v2-Chain', tr>)
        k2     = h(<Kpq, Kclass, e, ctr, policyHash, 'MARK-X-Phase3', tr>)
        m3     = <'promote-to-PQ', e_recv, ctr_recv, tag2>
    in
    [ St_Client_2(sid_c, $C, $S, sid_prev_c, x, policyHash, algId, paramId, e, ctr, pkpq, pkeph, m1,
                  ctpq, gx, Kpq, Kclass, tr)
    , In(m3) ]
  --[ Eq(tag2, mac(k2, <'promote-to-PQ', e_recv, ctr_recv, algId, policyHash>))
    , Eq(e_recv, e)
    , Eq(ctr_recv, ctr)
    , ClientAccepts(sid_c, $C, $S, e, ctr, algId, paramId, policyHash, pkpq)
    , ClientKtrans(sid_c, $C, Ktrans)
    , ClientKchain(sid_c, $C, Kchain_new)
    ]->
    [ !KtransOf(sid_c, Ktrans) ]

/* ------------------------------------------------------------------ *
 * Restrictions
 * ------------------------------------------------------------------ */

/* ------------------------------------------------------------------ *
 * Sources lemma (supplies the human insight the autoprover lacks).
 *
 * The server decapsulates a ciphertext it received from the network:
 *   Kpq = kemDec(ctpq, skpq),  ctpq bound by In(...)
 * Tamarin cannot, on its own, determine where that Kpq came from. Every
 * occurrence therefore leaves an open chain (a partial deconstruction),
 * and the constraint solver re-explores those chains inside every later
 * goal -- which is what makes the two-DH-term A2 theories diverge.
 *
 * The insight is simply: a shared secret the server ends up holding was
 * either produced by an honest client's encapsulation, or was known to
 * the adversary all along. Nothing else can produce it. Stating that as
 * a [sources] lemma lets Tamarin discharge it once, by induction, and
 * then reuse it to close the chains everywhere else.
 * ------------------------------------------------------------------ */

lemma kpq_origin [sources]:
    " All sid S Kpq #i.
        ServerHasKpq(sid, S, Kpq) @ #i
        ==>
          (Ex #j. KU(Kpq) @ #j & #j < #i)
        | (Ex sid_c C #j. ClientHasKpq(sid_c, C, Kpq) @ #j & #j < #i) "

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

/* ------------------------------------------------------------------ *
 * Lemmas
 * ------------------------------------------------------------------ */

lemma sanity_executable:
  exists-trace
    " Ex sid_c C S e ctr alg param ph pkpq #i.
        ClientAccepts(sid_c, C, S, e, ctr, alg, param, ph, pkpq) @ #i "


// Anchor retirement, symbolic form (paper: Classical Anchor Independence).
//
// A client accepts a bootstrap under anchor `mode` only if `mode` was in its
// own allow-list.  Note what is ABSENT from the hypotheses: there is no
// freshness condition and no restriction on CorruptSig.  The lemma therefore
// holds even when the adversary holds sk_sig outright, which is exactly the
// claim of the theorem -- refusal happens at the policy check, before the
// signature can matter.
//
// A classically sunset client is one for which SetupClientAllowsAnchor is
// never instantiated with 'modeA_c'.  For such a client no
// AnchorAllowed(C, 'modeA_c') event exists, so by this lemma no
// ClientAcceptedAnchor(_, C, 'modeA_c') event can exist either: the
// classically-anchored path is unreachable.
lemma anchor_retirement:
    " All sid_c C modeTag #i.
        ClientAcceptedAnchor(sid_c, C, modeTag) @ #i
        ==>
        Ex #j. AnchorAllowed(C, modeTag) @ #j & #j < #i "

lemma sunset_refuses_classical:
    " All sid_c C #i.
        ClientAcceptedAnchor(sid_c, C, 'modeA_c') @ #i
        ==>
        Ex #j. AnchorAllowed(C, 'modeA_c') @ #j & #j < #i "

lemma policy_compliance:
    " All sid_c C S e ctr alg param ph pkpq #i.
        ClientAccepts(sid_c, C, S, e, ctr, alg, param, ph, pkpq) @ #i
        ==>
        Ex #j. ClientChecksPolicy(C, ph) @ #j & #j < #i "

// chain-bootstrap authenticity.
// If a client accepts a chained-epoch m_1, then either an honest
// server performed the matching chain step, or the prior K_chain
// was revealed.
lemma chain_auth:
    " All sid_c C sid_prev_c #i.
        ClientChainStep(sid_c, C, sid_prev_c) @ #i
        & not (Ex sid #r. RevealKchain(sid) @ #r & #r < #i)
        ==>
        Ex sid_s S sid_prev_s #j.
            ServerChainStep(sid_s, S, sid_prev_s) @ #j
            & #j < #i "

lemma secrecy_ktrans:
    " All sid_c C S e ctr alg param ph pkpq ktrans #i.
        ClientKtrans(sid_c, C, ktrans) @ #i
        & ClientAccepts(sid_c, C, S, e, ctr, alg, param, ph, pkpq) @ #i
        & not (Ex sid_s #r. CorruptKEM(sid_s, S) @ #r)
        & not (Ex sid_s #r. CorruptServerEph(sid_s, S) @ #r)
        & not (Ex #r. CorruptClientEph(sid_c, C) @ #r)
        & not (Ex sid #r. RevealKtrans(sid) @ #r)
        & not (Ex sid #r. RevealKchain(sid) @ #r)
        ==> not (Ex #k. K(ktrans) @ #k) "

lemma secrecy_ktrans_one_leak:
    " All sid_c C S e ctr alg param ph pkpq ktrans #i.
        ClientKtrans(sid_c, C, ktrans) @ #i
        & ClientAccepts(sid_c, C, S, e, ctr, alg, param, ph, pkpq) @ #i
        & not (Ex sid_s #r. CorruptKEM(sid_s, S) @ #r)
        & not ((Ex sid_s #r. CorruptServerEph(sid_s, S) @ #r)
               & (Ex #r. CorruptClientEph(sid_c, C) @ #r))
        & not (Ex sid #r. RevealKtrans(sid) @ #r)
        & not (Ex sid #r. RevealKchain(sid) @ #r)
        ==> not (Ex #k. K(ktrans) @ #k) "

end